<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_tax_invoice_layout">
        <div class="article aa_tax_invoice" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

    <template id="report_tax_invoice_document">
        <t t-call="aa_tax_invoice.report_tax_invoice_layout">
            <div class="page" style="margin-top:0px;padding-top:0px;">
                <t t-set="is_refund" t-value="o.move_type == 'out_refund'"/>
                <t t-set="is_simplified" t-value="o.aa_is_simplified()"/>
                <t t-set="confirmation_datetime" t-value="o.aa_get_confirmation_datetime()"/>
                <t t-set="supply_date" t-value="o.aa_get_supply_date()"/>
                <t t-set="qr" t-value="o.aa_get_qr_info()"/>

                <!-- Title -->
                <center>
                    <t t-if="is_refund and is_simplified">
                        <h4>إشعار دائن مبسط</h4>
                        <h4>Simplified Credit Note</h4>
                    </t>
                    <t t-elif="is_refund">
                        <h4>إشعار دائن</h4>
                        <h4>Credit Note</h4>
                    </t>
                    <t t-elif="o.move_type == 'out_invoice' and is_simplified">
                        <h4>فاتورة ضريبية مبسطة</h4>
                        <h4>Simplified Tax Invoice</h4>
                    </t>
                    <t t-else="">
                        <h4>فاتورة ضريبية</h4>
                        <h4>Tax Invoice</h4>
                    </t>
                </center>

                <!-- Document information + QR -->
                <table width="100%" class="table table-sm table-bordered" style="font-size:12px;">
                    <tr>
                        <th width="15%" class="text-left">Type</th>
                        <td width="20%" class="text-left">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                        </td>
                        <td width="20%" class="text-right">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">فاتورة</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">فاتورة مبدئية</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">فاتورة ملغية</span>
                            <span t-if="o.move_type == 'out_refund'">إشعار دائن</span>
                            <span t-if="o.move_type == 'in_refund'">إشعار خصم مورد</span>
                            <span t-if="o.move_type == 'in_invoice'">فاتورة مورد</span>
                        </td>
                        <th width="15%" class="text-right">النوع</th>
                        <td width="20%" rowspan="6" class="aa_qr_cell">
                            <img t-if="qr['image']" t-att-src="qr['image']"/>
                            <div t-if="qr['message']" class="aa_qr_note" t-esc="qr['message']"/>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-left">Number</th>
                        <td colspan="2" class="text-center"><span t-field="o.name"/></td>
                        <th class="text-right">رقم الفاتورة</th>
                    </tr>
                    <tr>
                        <th class="text-left">Issue Date</th>
                        <td colspan="2" class="text-center"><span t-field="o.invoice_date"/></td>
                        <th class="text-right">تاريخ الإصدار</th>
                    </tr>
                    <tr t-if="o.company_id.id != 6">
                        <th class="text-left">Confirm Date</th>
                        <td colspan="2" class="text-center">
                            <span t-if="confirmation_datetime" t-esc="confirmation_datetime" t-options='{"widget": "datetime"}'/>
                        </td>
                        <th class="text-right">تاريخ الاعتماد</th>
                    </tr>
                    <tr t-if="o.company_id.id == 11">
                        <th class="text-left">Reference</th>
                        <td colspan="2" class="text-center"><span t-field="o.payment_reference"/></td>
                        <th class="text-right">المرجع</th>
                    </tr>
                    <tr t-else="">
                        <th class="text-left">Due Date</th>
                        <td colspan="2" class="text-center"><span t-field="o.invoice_date_due"/></td>
                        <th class="text-right">تاريخ الاستحقاق</th>
                    </tr>
                    <tr t-if="o.company_id.id != 6">
                        <th class="text-left">Delivery Date</th>
                        <td colspan="2" class="text-center">
                            <span t-if="supply_date" t-esc="supply_date" t-options='{"widget": "date"}'/>
                            <t t-if="o.from_date or o.to_date">
                                <br/>
                                <span t-field="o.from_date" t-options='{"format": "HH:mm:ss"}'/> -
                                <span t-field="o.to_date" t-options='{"format": "HH:mm:ss"}'/>
                            </t>
                        </td>
                        <th class="text-right">تاريخ التوصيل</th>
                    </tr>
                    <tr t-if="o.company_id.id in (6, 34)">
                        <th class="text-left">Customer Reference</th>
                        <td colspan="2" class="text-center"><span t-field="o.ref"/></td>
                        <th class="text-right">مرجع العميل</th>
                    </tr>
                    <tr>
                        <th class="text-left">Salesperson</th>
                        <td colspan="2" class="text-center">
                            <span t-field="o.invoice_user_id.name"/>
                            <br/>
                            <span t-field="o.invoice_user_id.partner_id.phone"/>
                            <br/>
                            <span t-field="o.invoice_user_id.partner_id.mobile"/>
                        </td>
                        <th class="text-right">البائع</th>
                    </tr>
                    <t t-if="is_refund">
                        <tr>
                            <th class="text-left">Original Invoice No.</th>
                            <td colspan="2" class="text-center"><span t-field="o.reversed_entry_id.name"/></td>
                            <th class="text-right">رقم الفاتورة الأصلية</th>
                        </tr>
                        <tr>
                            <th class="text-left">Original Invoice Date</th>
                            <td colspan="2" class="text-center"><span t-field="o.reversed_entry_id.invoice_date"/></td>
                            <th class="text-right">تاريخ الفاتورة الأصلية</th>
                        </tr>
                        <tr>
                            <th class="text-left">Reason</th>
                            <td colspan="2" class="text-center"><span t-field="o.ref"/></td>
                            <th class="text-right">سبب إصدار الإشعار</th>
                        </tr>
                    </t>
                </table>

                <!-- Customer / vendor -->
                <table width="100%" class="table table-sm table-bordered" style="font-size:12px;">
                    <tr style="background-color:gray;color:white;">
                        <th width="20%" class="text-left">Type</th>
                        <td width="30%" class="text-center">
                            <span t-if="o.move_type in ['out_invoice', 'out_refund']">Customer</span>
                            <span t-if="o.move_type in ['in_invoice', 'in_refund']">Vendor</span>
                        </td>
                        <td width="30%" class="text-center">
                            <span t-if="o.move_type in ['out_invoice', 'out_refund']">عـمـيل</span>
                            <span t-if="o.move_type in ['in_invoice', 'in_refund']">مـورد</span>
                        </td>
                        <th width="20%" class="text-right">النوع</th>
                    </tr>
                    <tr>
                        <th class="text-left">Name</th>
                        <td colspan="2" class="text-center" style="font-size:15px;"><span t-field="o.partner_id.name"/></td>
                        <th class="text-right">الإسم</th>
                    </tr>
                    <tr>
                        <th class="text-left">Phone</th>
                        <td colspan="2" class="text-center"><span t-field="o.partner_id.phone"/></td>
                        <th class="text-right">رقم الجوال</th>
                    </tr>
                    <tr t-if="o.company_id.id != 6">
                        <th class="text-left">Address</th>
                        <td colspan="2" class="text-center">
                            <span t-field="o.partner_id.street"/>
                            <span t-field="o.partner_id.street2"/>
                            <span t-field="o.partner_id.city"/>
                            <span t-if="'district' in o.partner_id._fields" t-field="o.partner_id.district"/>
                            <span t-field="o.partner_id.state_id"/>
                            <span t-if="'building_no' in o.partner_id._fields" t-field="o.partner_id.building_no"/>
                            <span t-field="o.partner_id.zip"/>
                        </td>
                        <th class="text-right">العنوان</th>
                    </tr>
                    <tr>
                        <th class="text-left">VAT Number</th>
                        <td colspan="2" class="text-center"><span t-field="o.partner_id.vat"/></td>
                        <th class="text-right">رقم تسجيل ضريبة القيمة المضافة</th>
                    </tr>
                </table>

                <!-- Lines -->
                <table class="table table-sm table-bordered" style="font-size:10px;" name="invoice_line_table">
                    <thead>
                        <tr style="background-color:#464343;color:white;">
                            <th class="text-left"><div>Description</div><div>السلع او الخدمات</div></th>
                            <th class="text-right"><div>Quantity</div><div>الكمية</div></th>
                            <th class="text-right"><div>Unit Price</div><div>سعر الوحدة</div></th>
                            <th class="text-right"><div>Discount</div><div>خصومات</div></th>
                            <th class="text-right"><div>Taxable Amount</div><div>المبلغ الخاضع للضريبة</div></th>
                            <th class="text-left"><div>VAT Rate</div><div>نسبة الضريبة</div></th>
                            <th class="text-right"><div>VAT Amount</div><div>مبلغ الضريبة</div></th>
                            <th class="text-right"><div>Total (Including VAT)</div><div>المجموع (شامل الضريبة)</div></th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda l: not l.display_type).sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                        <tr t-foreach="lines" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-right"><span t-field="line.quantity"/></td>
                            <td class="text-right">
                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-right"><span t-field="line.aa_discount_amount"/></td>
                            <td class="text-right"><span t-field="line.price_subtotal"/></td>
                            <td class="text-left"><span t-esc="line.aa_get_vat_rate_label()"/></td>
                            <td class="text-right"><span t-field="line.aa_tax_amount"/></td>
                            <td class="text-right"><span t-field="line.price_total"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals -->
                <table width="100%" class="table table-sm table-bordered" style="font-size:12px;">
                    <tr style="background-color:gray;color:white;">
                        <th width="30%" class="text-left">Total Amounts</th>
                        <th width="40%"/>
                        <th width="30%" class="text-right">إجمالي المبالغ</th>
                    </tr>
                    <tr>
                        <th class="text-left">Total (Excluding VAT)</th>
                        <td class="text-right"><span t-field="o.amount_untaxed"/></td>
                        <th class="text-right">الإجمالي (غير شامل الضريبة)</th>
                    </tr>
                    <tr t-if="o.aa_total_discount">
                        <th class="text-left">Discount</th>
                        <td class="text-right"><span t-field="o.aa_total_discount"/></td>
                        <th class="text-right">مجموع الخصومات</th>
                    </tr>
                    <tr>
                        <th class="text-left">Total VAT</th>
                        <td class="text-right"><span t-field="o.amount_tax"/></td>
                        <th class="text-right">مجموع الضريبة</th>
                    </tr>
                    <tr t-if="o.currency_id != o.company_id.currency_id">
                        <th class="text-left">Total VAT (<t t-esc="o.company_id.currency_id.name"/>)</th>
                        <td class="text-right">
                            <span t-esc="abs(o.amount_tax_signed)" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                        </td>
                        <th class="text-right">مجموع الضريبة (<t t-esc="o.company_id.currency_id.name"/>)</th>
                    </tr>
                    <tr>
                        <th class="text-left">Total (Including VAT)</th>
                        <td class="text-right"><span t-field="o.amount_total"/></td>
                        <th class="text-right">المجموع (شامل الضريبة)</th>
                    </tr>
                    <tr>
                        <th class="text-left">Amount Due</th>
                        <td class="text-right"><span t-field="o.amount_residual"/></td>
                        <th class="text-right">المبلغ المتبقي</th>
                    </tr>
                </table>

                <p t-if="o.narration">
                    <strong>Comment:</strong>
                    <span t-field="o.narration"/>
                </p>
                <p t-if="o.invoice_payment_term_id.note">
                    <span t-field="o.invoice_payment_term_id.note"/>
                </p>
                <p t-if="o.fiscal_position_id.note">
                    <strong>Fiscal Position Remark:</strong>
                    <span t-field="o.fiscal_position_id.note"/>
                </p>

                <!-- Payments -->
                <t t-set="payment_lines" t-value="o.aa_get_payment_lines()"/>
                <table width="100%" class="table table-sm table-bordered" style="font-size:12px;">
                    <thead>
                        <tr style="background-color:#464343;color:white;">
                            <th colspan="2">Payment Information</th>
                            <th colspan="2" class="text-right">معلومات السداد</th>
                        </tr>
                        <tr style="background-color:gray;color:white;">
                            <th><div>Number</div><div>الرقم</div></th>
                            <th><div>Date</div><div>التاريخ</div></th>
                            <th><div>Method</div><div>الطريقة</div></th>
                            <th class="text-right"><div>Amount</div><div>المبلغ</div></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="payment_lines" t-as="p">
                            <td><span t-esc="p.get('name')"/></td>
                            <td><span t-esc="p.get('date')"/></td>
                            <td><span t-esc="p.get('journal_name')"/></td>
                            <td class="text-right">
                                <span t-esc="p.get('amount')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_tax_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang='en_US')"/>
                <t t-set="rtl" t-value="(user.lang or '').startswith('ar')"/>

                <div class="header aa_tax_invoice_header" t-att-style="'direction: rtl;' if rtl else 'direction: ltr;'">
                    <div class="o_boxed_header" style="margin-top:10px;padding-top:10px;">
                        <table width="100%">
                            <tr>
                                <td width="40%" style="vertical-align:top;">
                                    <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                    <span t-if="o.company_id.vat">
                                        <t t-if="rtl">الرقم الضريبي</t><t t-else="">Tax ID</t>:
                                        <span t-field="o.company_id.vat"/>
                                    </span>
                                </td>
                                <td width="20%" style="vertical-align:top;text-align:center;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height:100px;max-width:100%;"/>
                                </td>
                                <td width="40%" t-att-style="'vertical-align:top;text-align:left;' if rtl else 'vertical-align:top;text-align:right;'">
                                    <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                    <span t-if="o.company_id.vat">
                                        <t t-if="rtl">Tax ID</t><t t-else="">الرقم الضريبي</t>:
                                        <span t-field="o.company_id.vat"/>
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <t t-call="aa_tax_invoice.report_tax_invoice_document"/>

                <div class="footer o_background_footer aa_tax_invoice_footer">
                    <div class="text-center">
                        <ul class="list-inline">
                            <li t-if="o.company_id.phone" class="list-inline-item">
                                <i class="fa fa-phone" role="img" aria-label="Phone" title="Phone"/>
                                <span t-field="o.company_id.phone"/>
                            </li>
                            <li t-if="o.company_id.email" class="list-inline-item">
                                <i class="fa fa-at" role="img" aria-label="Email" title="Email"/>
                                <span t-field="o.company_id.email"/>
                            </li>
                            <li t-if="o.company_id.website" class="list-inline-item">
                                <i class="fa fa-globe" role="img" aria-label="Website" title="Website"/>
                                <span t-field="o.company_id.website"/>
                            </li>
                            <li t-if="o.company_id.vat" class="list-inline-item">
                                <i class="fa fa-building-o" role="img" aria-label="Fiscal number"/>
                                <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="o.company_id.vat"/>
                            </li>
                        </ul>
                        <div t-field="o.company_id.report_footer"/>
                        <div class="text-muted">
                            Page: <span class="page"/> / <span class="topage"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
