<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_aa_tax_invoice" model="ir.actions.report">
        <field name="name">Tax Invoice (ZATCA)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aa_tax_invoice.report_tax_invoice</field>
        <field name="report_file">aa_tax_invoice.report_tax_invoice</field>
        <field name="print_report_name">(object.move_type == 'out_refund' and 'Credit Note - ' or 'Tax Invoice - ') + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
