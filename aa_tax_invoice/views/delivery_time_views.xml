<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Merged from delivery_time_custom -->
    <record id="view_delivery_time_from_to" model="ir.ui.view">
        <field name="name">account.move.form.aa.delivery.time</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="from_date" string="From Time" attrs="{'required': [('company_id', '=', 5)], 'readonly': [('state', 'in', ('cancel', 'posted'))]}"/>
                <field name="to_date" string="To Time" attrs="{'required': [('company_id', '=', 5)], 'readonly': [('state', 'in', ('cancel', 'posted'))]}"/>
                <field name="invoice_payment_term_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.aa.customer.info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="replace">
                <field name="phone" attrs="{'required': [('company_id', '=', 5)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
